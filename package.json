{
  "name": "stickerfolio",
  "version": "2.0.0-rc.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "A portable, mobile-first sticker album tracker for multiple collectors.",
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./scripts/client-address-preload.mjs' next dev --port 3500",
    "build": "next build",
    "start": "NODE_OPTIONS='--import ./scripts/client-address-preload.mjs' next start --port 3500",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:migrate:down": "tsx scripts/migrate.ts down",
    "seed:catalogs": "tsx scripts/seed-bundled-catalogs.ts",
    "seed:euro2024": "tsx scripts/seed-euro2024.ts",
    "seed:wm2026": "tsx scripts/seed-wm2026.ts",
    "seed:example-holdings": "tsx scripts/seed-example-holdings.ts",
    "benchmark:argon2": "tsx scripts/benchmark-argon2.ts",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "loadtest:seed": "tsx load-test/seed/seed-load-dataset.ts",
    "loadtest:explain": "tsx load-test/scripts/run-explain.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "better-auth": "^1.7.18",
    "next": "16.4.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^22.19.0",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.14.0"
}
