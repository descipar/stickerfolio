# Required runtime configuration
DATABASE_URL=postgresql://stickerfolio:replace-me@localhost:5432/stickerfolio
APP_BASE_URL=http://localhost:3500
# Optional. Enables share links only when set to an origin reachable by recipients.
# Localhost and loopback addresses are rejected. LAN addresses are supported.
PUBLIC_SHARE_BASE_URL=
BETTER_AUTH_SECRET=replace-this-with-at-least-32-random-characters
# Optional. Set only when a trusted reverse proxy removes the incoming value
# and writes the real client address into this single-value header.
AUTH_TRUSTED_IP_HEADER=
REGISTRATION_MODE=closed

# Bundled Docker Compose database. Change this outside throwaway local development.
POSTGRES_PASSWORD=replace-me
POSTGRES_USER=stickerfolio
POSTGRES_DB=stickerfolio
APP_PORT=3500

# PostgreSQL TLS: disable, require, verify-ca, or verify-full.
# Bundled Compose uses disable inside its private Docker network.
# For an external production database, use verify-full with the provider CA.
# "require" encrypts traffic but does not verify the server identity.
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Optional SMTP adapter
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=stickerfolio
# SMTP_PASSWORD=replace-me
# SMTP_FROM=Stickerfolio <stickerfolio@example.com>
